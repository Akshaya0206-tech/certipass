# Copy to `.env.local` (git-ignored). Nothing here is secret: Vite embeds these values in the
# browser bundle, so NEVER put a Google credential, an AUTH_PEPPER, a SETUP_TOKEN or a refresh
# token in this file. Those live only in the Worker (see worker/.dev.vars.example).

# Address of the CertiPass Worker, e.g. http://127.0.0.1:8787 while developing, or https://certipass.<account>.workers.dev.
# Setting it switches the app from the offline prototype to REAL sign-in and REAL certificate storage in Google Drive
# (see docs/BACKEND_SETUP.md). Leave empty to run the prototype exactly as before: local demo accounts, and
# certificates checked in the browser and not stored anywhere.
VITE_CERT_API_URL=

# Link to the certificate folder in Google Drive. Powers the admin "Open Google Drive Folder" button
# (Settings → Certificate files, and Achievement Records). Must be a plain https://drive.google.com/drive/folders/<id> link.
# The id is visible to anyone who can read the built site, so the Drive folder must be "Restricted":
# the id alone lets nobody in. Once the Worker is connected, administrators get the link from it instead.
VITE_DRIVE_FOLDER_URL=
