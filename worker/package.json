{
  "name": "certipass-certificate-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CertiPass backend on Cloudflare Workers: accounts and sign-in (D1), and certificates stored privately in Google Drive.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "admin:create": "tsx scripts/create-admin.ts",
    "drive:authorize": "tsx scripts/authorize.ts",
    "drive:check": "tsx scripts/check-drive.ts",
    "drive:sample": "tsx scripts/sample-upload.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "5.8",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  }
}
